# Copy to .env (gitignored). Never put keys in code.

# Tier B — live speech-native systems under test
OPENAI_API_KEY=
GEMINI_API_KEY=

# Tier B — cascaded system under test (STT -> LLM -> TTS)
NOVIS_API_KEY=
NOVIS_BASE_URL=

# Tier C — telephony harness
TELNYX_API_KEY=
TELNYX_SIP_USER=
TELNYX_SIP_PASSWORD=

# Tier C — SIP trunk for the bridged cell (speech-native over PSTN).
# The trunk must answer G.711 mu-law at 20 ms; bridge.accept_sdp_answer refuses anything else,
# because a wideband answer would put the wrong transport in a preregistered cell.
SIP_REGISTRAR=
SIP_USER=
SIP_PASSWORD=
SIP_DID=

# Media address the bridge advertises in its SDP offer. RTP must actually reach this, so a
# laptop behind NAT will not do.
BRIDGE_MEDIA_HOST=
BRIDGE_MEDIA_PORT=40000
